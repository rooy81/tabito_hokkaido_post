<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>おすすめの宿 — 旅人北海道</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy: #0a0f1c;
      --navy-mid: #141a2e;
      --ice: #7ec8e3;
      --ice-light: #b8e4f2;
      --white: #f8f9fa;
      --gray: #6c757d;
      --transition: 0.3s cubic-bezier(0.4,0,0.2,1);
    }
    html { scroll-behavior: smooth; }
    body { font-family: 'Noto Sans JP', sans-serif; background: #f0f2f5; color: #1a1a2e; min-height: 100vh; }

    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 32px;
      background: rgba(10,15,28,0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(126,200,227,0.15);
    }
    .nav-logo {
      font-family: 'Playfair Display', serif;
      color: #fff; font-size: 1.15rem; letter-spacing: 0.12em; text-decoration: none;
    }
    .nav-logo span { color: var(--ice); }
    .nav-links { display: flex; gap: 24px; align-items: center; }
    .nav-links a {
      color: rgba(255,255,255,0.6); font-size: 0.8rem; text-decoration: none;
      letter-spacing: 0.05em; transition: color var(--transition);
    }
    .nav-links a:hover, .nav-links a.active { color: var(--ice); }

    .hero {
      padding: 120px 24px 60px;
      background: linear-gradient(160deg, #0a0f1c 0%, #0d1f3c 60%, #0a2540 100%);
      text-align: center;
      position: relative; overflow: hidden;
    }
    .hero::before {
      content: ''; position: absolute; inset: 0;
      background: url('https://images.unsplash.com/photo-1495562569060-2eec283d3391?w=1200&q=60') center/cover no-repeat;
      opacity: 0.12;
    }
    .hero-inner { position: relative; z-index: 1; max-width: 640px; margin: 0 auto; }
    .hero-eyebrow {
      display: inline-block; color: var(--ice); font-size: 0.7rem;
      letter-spacing: 0.3em; text-transform: uppercase; margin-bottom: 16px;
      border: 1px solid rgba(126,200,227,0.4); padding: 5px 16px; border-radius: 100px;
    }
    .hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 6vw, 3.5rem); color: #fff;
      line-height: 1.1; margin-bottom: 14px;
    }
    .hero h1 em { font-style: italic; color: var(--ice-light); }
    .hero-sub {
      color: rgba(255,255,255,0.6); font-size: 0.9rem;
      font-weight: 300; line-height: 1.8;
    }

    .filter-bar {
      position: sticky; top: 57px; z-index: 90;
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid #e0e4ec;
      padding: 12px 24px;
      display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
    }
    .filter-btn {
      padding: 6px 16px; border-radius: 100px;
      border: 1.5px solid #dde1e9; background: #f8f9fa;
      font-size: 0.78rem; color: #555; cursor: pointer;
      transition: all var(--transition); white-space: nowrap;
      font-family: 'Noto Sans JP', sans-serif;
    }
    .filter-btn:hover { border-color: var(--ice); color: #0a2540; }
    .filter-btn.active {
      background: var(--navy); border-color: var(--navy); color: var(--ice);
    }
    .filter-count {
      margin-left: auto; font-size: 0.75rem; color: #999;
      white-space: nowrap;
    }

    .grid-wrap { max-width: 1100px; margin: 0 auto; padding: 32px 16px 60px; }

    .hotel-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 20px;
    }

    .hotel-card {
      background: #fff; border-radius: 16px; overflow: hidden;
      box-shadow: 0 2px 16px rgba(0,0,0,0.07);
      transition: transform var(--transition), box-shadow var(--transition);
      cursor: pointer;
    }
    .hotel-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 28px rgba(0,0,0,0.13);
    }

    .card-thumb-wrap {
      position: relative; aspect-ratio: 4/5; overflow: hidden;
      background: #1a2a3a;
    }
    .card-thumb-wrap img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 0.5s ease;
    }
    .hotel-card:hover .card-thumb-wrap img { transform: scale(1.04); }
    .card-thumb-placeholder {
      width: 100%; height: 100%;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 10px;
    }
    .tiktok-icon { width: 36px; height: 36px; }

    .play-overlay {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      background: rgba(0,0,0,0.18);
      transition: background var(--transition);
    }
    .hotel-card:hover .play-overlay { background: rgba(0,0,0,0.28); }
    .play-btn {
      width: 52px; height: 52px; border-radius: 50%;
      background: rgba(255,255,255,0.9);
      display: flex; align-items: center; justify-content: center;
      transition: transform var(--transition), background var(--transition);
    }
    .hotel-card:hover .play-btn { transform: scale(1.1); background: #fff; }
    .play-btn svg { width: 20px; height: 20px; fill: #0a0f1c; margin-left: 3px; }

    .tiktok-badge {
      position: absolute; top: 10px; left: 10px;
      background: rgba(0,0,0,0.65); border-radius: 8px;
      padding: 4px 9px; display: flex; align-items: center; gap: 5px;
    }
    .tiktok-badge svg { width: 13px; height: 13px; fill: #fff; }
    .tiktok-badge span { font-size: 10px; color: #fff; font-weight: 500; }

    .price-badge {
      position: absolute; bottom: 10px; right: 10px;
      background: rgba(0,0,0,0.72); border-radius: 8px;
      padding: 4px 10px;
    }
    .price-badge span { font-size: 11px; color: #fff; font-weight: 500; }

    .card-body { padding: 14px 16px 16px; }
    .card-area {
      display: inline-block; font-size: 10px; font-weight: 500;
      padding: 3px 10px; border-radius: 20px;
      background: #e8f4f8; color: #0a4a60; margin-bottom: 8px;
    }
    .card-name {
      font-size: 0.95rem; font-weight: 500; color: #1a1a2e;
      line-height: 1.4; margin-bottom: 8px;
    }
    .card-comment {
      font-size: 0.8rem; color: #666; line-height: 1.6;
      border-left: 3px solid var(--ice); padding-left: 10px;
      font-style: italic;
    }
    .card-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 10px; }
    .tag { font-size: 10px; padding: 2px 9px; border-radius: 20px; background: #f0f2f5; color: #666; }

    .modal-overlay {
      display: none; position: fixed; inset: 0; z-index: 200;
      background: rgba(0,0,0,0.82);
      align-items: center; justify-content: center;
      padding: 20px;
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
      background: #fff; border-radius: 20px; overflow: hidden;
      width: 100%; max-width: 420px;
      max-height: 90vh; overflow-y: auto;
    }
    .modal-head {
      background: var(--navy); padding: 16px 20px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .modal-head h3 { color: #fff; font-size: 0.9rem; font-weight: 500; }
    .modal-close {
      background: none; border: none; cursor: pointer;
      color: rgba(255,255,255,0.6); font-size: 1.4rem; line-height: 1;
      padding: 0 4px;
    }
    .modal-close:hover { color: #fff; }
    .modal-embed {
      aspect-ratio: 4/5; background: #000; overflow: hidden;
      position: relative;
    }
    .modal-embed iframe {
      position: absolute; top: 50%; left: 50%;
      width: 100%; height: 142%;
      transform: translate(-50%, -50%);
      border: none;
    }
    .modal-info { padding: 16px 20px; }
    .modal-name { font-size: 1rem; font-weight: 500; margin-bottom: 6px; }
    .modal-comment {
      font-size: 0.82rem; color: #555; line-height: 1.65;
      border-left: 3px solid var(--ice); padding-left: 10px;
      font-style: italic; margin-bottom: 12px;
    }
    .modal-meta { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .modal-price { font-size: 0.85rem; color: #444; }
    .modal-price b { font-size: 1rem; color: #1a1a2e; }
    .modal-tiktok-link {
      display: inline-flex; align-items: center; gap: 6px;
      background: #000; color: #fff; font-size: 0.78rem;
      padding: 8px 16px; border-radius: 8px; text-decoration: none;
      margin-top: 12px; font-weight: 500;
      transition: background var(--transition);
    }
    .modal-tiktok-link:hover { background: #333; }
    .modal-tiktok-link svg { width: 14px; height: 14px; fill: #fff; }

    .empty-state {
      text-align: center; padding: 80px 20px; color: #999; display: none;
    }
    .empty-state.show { display: block; }

    footer {
      background: var(--navy); color: rgba(255,255,255,0.5);
      text-align: center; padding: 32px 24px; font-size: 0.75rem;
    }
    footer a { color: var(--ice); text-decoration: none; }

    @media (max-width: 600px) {
      nav { padding: 14px 20px; }
      .hotel-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
      .grid-wrap { padding: 20px 12px 48px; }
      .filter-bar { padding: 10px 12px; gap: 6px; }
      .filter-btn { font-size: 0.72rem; padding: 5px 12px; }
      .card-body { padding: 10px 12px 12px; }
      .card-name { font-size: 0.85rem; }
    }
    @media (max-width: 380px) {
      .hotel-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<nav>
  <a href="index.html" class="nav-logo">Tabito <span>Hokkaido</span></a>
  <div class="nav-links">
    <a href="index.html">ギャラリー</a>
    <a href="hotels.html" class="active">おすすめの宿</a>
  </div>
</nav>

<section class="hero">
  <div class="hero-inner">
    <span class="hero-eyebrow">Roy's Pick</span>
    <h1>本当に泊まって<br><em>良かった宿</em>だけ</h1>
    <p class="hero-sub">TikTokで紹介した宿を厳選掲載しています。<br>実際に泊まって感動した場所だけをお届けします。</p>
  </div>
</section>

<div class="filter-bar" id="filterBar">
  <button class="filter-btn active" data-area="all" onclick="filterArea('all',this)">すべて</button>
  <span class="filter-count" id="filterCount">0件</span>
</div>

<div class="grid-wrap">
  <div class="hotel-grid" id="hotelGrid"></div>
  <div class="empty-state" id="emptyState">
    <p style="font-size:2rem; margin-bottom:12px;">🏨</p>
    <p>該当する宿がありません</p>
  </div>
</div>

<div class="modal-overlay" id="modal" onclick="closeModal(event)">
  <div class="modal-box" id="modalBox">
    <div class="modal-head">
      <h3 id="modalName"></h3>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div class="modal-embed" id="modalEmbed"></div>
    <div class="modal-info">
      <p class="modal-comment" id="modalComment"></p>
      <div class="modal-meta">
        <span class="modal-area" id="modalArea"></span>
        <span class="modal-price" id="modalPrice"></span>
      </div>
      <a class="modal-tiktok-link" id="modalLink" href="#" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.91a8.19 8.19 0 004.79 1.53V7a4.86 4.86 0 01-1.02-.31z"/></svg>
        TikTokで見る
      </a>
    </div>
  </div>
</div>

<footer>
  <p>© 2024 旅人北海道 — <a href="https://www.instagram.com/tabito_hokkaido/" target="_blank">@tabito_hokkaido</a></p>
</footer>

<script>
const GITHUB_REPO = 'rooy81/tabito_hokkaido_post';
const HOTELS_FILE = 'hotels.json';

let allHotels = [];
let currentArea = 'all';
let currentHotel = null;

async function loadHotels() {
  try {
    const url = `https://raw.githubusercontent.com/${GITHUB_REPO}/main/${HOTELS_FILE}?t=${Date.now()}`;
    const res = await fetch(url);
    if (!res.ok) throw new Error('not found');
    allHotels = await res.json();
  } catch(e) {
    allHotels = [];
  }
  buildFilters();
  renderCards(allHotels);
}

function buildFilters() {
  const bar = document.getElementById('filterBar');
  const areas = [...new Set(allHotels.map(h => h.area).filter(Boolean))];
  const countSpan = document.getElementById('filterCount');
  const existing = bar.querySelectorAll('[data-area]:not([data-area="all"])');
  existing.forEach(e => e.remove());
  areas.forEach(area => {
    const btn = document.createElement('button');
    btn.className = 'filter-btn';
    btn.dataset.area = area;
    btn.textContent = area;
    btn.onclick = () => filterArea(area, btn);
    countSpan.before(btn);
  });
}

function filterArea(area, btn) {
  currentArea = area;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  const filtered = area === 'all' ? allHotels : allHotels.filter(h => h.area === area);
  renderCards(filtered);
}

function renderCards(hotels) {
  const grid = document.getElementById('hotelGrid');
  const empty = document.getElementById('emptyState');
  const countSpan = document.getElementById('filterCount');
  grid.innerHTML = '';
  countSpan.textContent = hotels.length + '件';

  if (hotels.length === 0) { empty.classList.add('show'); return; }
  empty.classList.remove('show');

  hotels.forEach((h, idx) => {
    const card = document.createElement('div');
    card.className = 'hotel-card';
    card.onclick = () => openModal(h);

    const thumbHtml = h.thumbnail_url
      ? `<img src="${h.thumbnail_url}" alt="${h.hotel_name}" loading="lazy">`
      : `<div class="card-thumb-placeholder">
          <svg class="tiktok-icon" viewBox="0 0 24 24" fill="#7ec8e3"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.91a8.19 8.19 0 004.79 1.53V7a4.86 4.86 0 01-1.02-.31z"/></svg>
          <span style="color:rgba(255,255,255,0.5);font-size:11px;">TikTok動画</span>
        </div>`;

    const tagsHtml = (h.tags || []).map(t => `<span class="tag">${t}</span>`).join('');
    const priceStr = h.price_from ? `¥${Number(h.price_from).toLocaleString()}〜` : '';

    card.innerHTML = `
      <div class="card-thumb-wrap">
        ${thumbHtml}
        <div class="play-overlay">
          <div class="play-btn">
            <svg viewBox="0 0 24 24"><polygon points="5,3 19,12 5,21"/></svg>
          </div>
        </div>
        <div class="tiktok-badge">
          <svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.91a8.19 8.19 0 004.79 1.53V7a4.86 4.86 0 01-1.02-.31z"/></svg>
          <span>TikTok</span>
        </div>
        ${priceStr ? `<div class="price-badge"><span>${priceStr}</span></div>` : ''}
      </div>
      <div class="card-body">
        ${h.area ? `<span class="card-area">${h.area}</span>` : ''}
        <p class="card-name">${h.hotel_name || ''}</p>
        ${h.comment ? `<p class="card-comment">${h.comment}</p>` : ''}
        ${tagsHtml ? `<div class="card-tags">${tagsHtml}</div>` : ''}
      </div>`;

    grid.appendChild(card);
  });
}

function openModal(h) {
  currentHotel = h;
  const tikId = h.tiktok_url && h.tiktok_url.match(/video\/(\d+)/)?.[1];
  document.getElementById('modalName').textContent = h.hotel_name || '';
  document.getElementById('modalComment').textContent = h.comment || '';
  document.getElementById('modalArea').textContent = h.area || '';
  document.getElementById('modalPrice').innerHTML = h.price_from
    ? `¥<b>${Number(h.price_from).toLocaleString()}</b>〜/泊` : '';
  document.getElementById('modalLink').href = h.tiktok_url || '#';

  const embed = document.getElementById('modalEmbed');
  if (tikId) {
    embed.innerHTML = `<iframe src="https://www.tiktok.com/embed/v2/${tikId}" allowfullscreen allow="encrypted-media"></iframe>`;
  } else if (h.thumbnail_url) {
    embed.innerHTML = `<img src="${h.thumbnail_url}" style="width:100%;height:100%;object-fit:cover;">`;
  } else {
    embed.innerHTML = `<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#fff;font-size:0.9rem;">動画を読み込めませんでした</div>`;
  }

  document.getElementById('modal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeModal(e) {
  if (e && e.target !== document.getElementById('modal') && !e.target.classList.contains('modal-close')) return;
  document.getElementById('modal').classList.remove('open');
  document.getElementById('modalEmbed').innerHTML = '';
  document.body.style.overflow = '';
}

document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal({}); });

loadHotels();
</script>
</body>
</html>
